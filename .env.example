# Firebase project and Web app configuration (not service account private keys).
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
SITE_ORIGIN=
# Comma-separated, verified email addresses; the default policy denies everyone.
ACCESS_POLICY=allowlist
ALLOWED_EMAILS=
# Store a base64/base64url 32-byte key in the hosting secret store.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Local development: GOOGLE_APPLICATION_CREDENTIALS can point to a private ADC file.
# Firebase App Hosting uses its managed service identity; no private key is committed.
