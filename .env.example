# Supabase Project Settings → API: public URL and publishable/anon key only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Local development only. Netlify supplies its production origin automatically.
SITE_ORIGIN=http://127.0.0.1:3000
# Must also be approved in dashboard_private.approved_emails in Supabase.
ALLOWED_EMAILS=rolihlahla.info@gmail.com
# Store a base64/base64url 32-byte key in the hosting secret store.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# A Supabase service-role key and database password are NOT required by the app.
